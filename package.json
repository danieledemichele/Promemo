{
  "name": "promemo",
  "productName": "Promemo",
  "version": "1.4.0",
  "description": "Impegni, piani e promemoria in un unico posto, con Google Calendar, Notion, Calendly e calendari .ics. App desktop per Linux.",
  "main": "main.js",
  "author": "Daniele De Michele <daniele@danieledemichele.it>",
  "license": "MIT",
  "homepage": "https://danieledemichele.it",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "it.danieledemichele.promemo",
    "productName": "Promemo",
    "files": [
      "main.js",
      "preload.js",
      "sync.js",
      "ics.js",
      "vault.js",
      "src/**/*",
      "build/icon.png",
      "!scripts/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Daniele De Michele <daniele@danieledemichele.it>"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danieledemichele/promemo.git"
  }
}
